<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.stormlegend.rcodex-go</string>
  <key>ProgramArguments</key><array>
    <string>/Users/USERNAME/Applications/rcodex-go/rcg</string>
    <string>-config</string><string>/Users/USERNAME/Library/Application Support/rcodex-go/gateway.json</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/USERNAME/Applications/rcodex-go</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/Users/USERNAME/.local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/USERNAME/Library/Logs/rcodex-go.log</string>
  <key>StandardErrorPath</key><string>/Users/USERNAME/Library/Logs/rcodex-go.error.log</string>
</dict></plist>
