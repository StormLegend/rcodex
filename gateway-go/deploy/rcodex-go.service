[Unit]
Description=rcodex Go Gateway
After=network-online.target

[Service]
Type=simple
User=%i
ExecStart=%h/bin/rcodex-go -config %h/.config/rcodex-go/gateway.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/rcodex-go
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
