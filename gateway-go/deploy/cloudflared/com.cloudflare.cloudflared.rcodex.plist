<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.cloudflare.cloudflared.rcodex</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>--config</string><string>/Users/USERNAME/Library/Application Support/rcodex-go/cloudflared/config.yml</string>
    <string>tunnel</string><string>run</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/USERNAME/Library/Application Support/rcodex-go/cloudflared</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/USERNAME/Library/Logs/cloudflared-rcodex.log</string>
  <key>StandardErrorPath</key><string>/Users/USERNAME/Library/Logs/cloudflared-rcodex.error.log</string>
</dict></plist>
