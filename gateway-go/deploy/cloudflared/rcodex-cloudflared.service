[Unit]
Description=Cloudflare Tunnel for rcodex-go
After=network-online.target rcodex-go.service
Wants=network-online.target

[Service]
Type=simple
User=%i
ExecStart=%h/bin/cloudflared --config %h/.config/rcodex-go/cloudflared/config.yml tunnel run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.config/rcodex-go/cloudflared
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
