[Unit]
Description=rcodex Relay Server
After=network-online.target

[Service]
Type=simple
User=%i
ExecStart=%h/bin/rcodex-relay -config %h/.config/rcodex-relay/relay.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/rcodex-relay
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
